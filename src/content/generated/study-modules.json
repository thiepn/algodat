      ],
      "learningObjectives": [
        "Eine prüfbare Invariante statt einer bloßen Ergebnisbehauptung formulieren.",
        "Initialisierung, Erhaltung und Terminierung getrennt bearbeiten.",
        "Aus der Invariante die Korrektheitsaussage ableiten."
      ],
      "coreIdeas": [
        "Die Invariante beschreibt den Zustand vor oder nach einer Iteration eindeutig.",
        "Der Abschluss ist kein neuer Beweis, sondern die Nutzung der Invariante am Schleifenende."
      ],
      "workedExamples": [
        {
          "title": "Dreiteiliger Beweisrahmen",
          "steps": [
            "Invariante mit Indexbereich notieren.",
            "Basis vor der ersten Iteration prüfen.",
            "Erhaltung mit einer allgemeinen Iteration zeigen."
          ],
          "sourceRefs": [
            {
              "sourceId": "src-25d6340b518c",
              "page": 11
            }
          ]
        }
      ],
      "commonMistakes": [
        "Invariante beschreibt nur das Endergebnis.",
        "Erhaltung wird an einem Beispiel statt allgemein gezeigt.",
        "Terminierung fehlt."
      ],
      "examTips": [
        "Überschriften Initialisierung, Erhaltung, Abschluss explizit setzen.",
        "Indexgrenzen nicht im Fließtext verstecken."
      ],
