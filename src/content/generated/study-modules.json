      "moduleId": "module-union-find-listen",
      "title": "Union-Find mit Listen sicher tracen",
      "summary": "Aktives Modul zu Vertreterzeigern, Listenverkettung und gewichteter Union.",
      "topicIds": [
        "topic-0ba342914656",
        "topic-595ab7b2682c"
      ],
      "taskNumbers": [
        2,
        4,
        9
      ],
      "prerequisiteModuleIds": [
