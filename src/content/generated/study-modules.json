      "moduleId": "module-schleifeninvariante",
      "title": "Schleifeninvariante beweisbar formulieren",
      "summary": "Lernmodul für Initialisierung, Erhaltung und Abschluss einer Schleifeninvariante.",
      "topicIds": [
        "topic-e05ae3743b24"
      ],
      "taskNumbers": [
        5,
        9
