      "learningObjectives": [
        "MakeSet-, Find- und Union-Schritte sauber unterscheiden.",
        "Repräsentanten und Listengrößen nach jedem Checkpoint prüfen.",
        "Gewichtete Union ohne stille Tie-Break-Änderung anwenden."
      ],
      "coreIdeas": [
        "Der sichtbare Zustand ist eine Folge von Mengen, Repräsentanten und Nachfolgerbeziehungen.",
        "Jeder Merge-Schritt muss die gewählte kleinere Liste nachvollziehbar machen."
      ],
      "workedExamples": [
        {
          "title": "Checkpoint-Kontrolle nach Union",
          "steps": [
            "Die beiden Vertreter vor Union bestimmen.",
            "Die kleinere Liste an die größere anhängen.",
            "Alle betroffenen Repräsentantenzeiger aktualisieren."
          ],
          "sourceRefs": [
            {
              "sourceId": "src-8f16b2505bbd",
              "page": 6
            }
          ]
        }
      ],
      "commonMistakes": [
