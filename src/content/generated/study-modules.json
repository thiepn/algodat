    {
      "moduleId": "module-rucksack-dp",
      "title": "Rucksack-DP aktiv beherrschen",
      "summary": "Quellengebundenes Lernmodul zum 0/1-Rucksack-Tracing mit Zustandsdefinition, Tabellenaufbau und aktivem Traineranschluss.",
      "topicIds": [
        "topic-f5b57f47447c",
        "topic-c0af8532bb72"
      ],
      "taskNumbers": [
        1,
        2,
        8
      ],
      "prerequisiteModuleIds": [
        "module-entwurfsparadigmen"
      ],
      "learningObjectives": [
        "Zustand und Tabellenachsen vor dem Rechnen benennen.",
        "Jede Tabellenzelle aus der vorherigen Zeile begründen.",
        "Das Optimum aus der letzten Tabellenzelle ablesen."
      ],
      "coreIdeas": [
        "Aktives Tabellenfüllen ist wichtiger als passives Lesen der Musterlösung.",
        "Der Trainer nutzt nur öffentlich freigegebene, quellenreferenzierte Instanzen."
      ],
      "workedExamples": [
        {
          "title": "Mini-Tabelle vor dem Prüfungsmodus",
          "steps": [
            "Kapazität und Gegenstände notieren.",
            "Nullzeile vollständig setzen.",
            "Für jede Zelle zwischen Übernehmen und Einpacken entscheiden."
          ],
          "sourceRefs": [
            {
              "sourceId": "src-25d6340b518c",
              "page": 33,
              "label": "Vorlesungs-/Aufgabenbezug Rucksack-DP"
            }
          ]
        }
      ],
      "commonMistakes": [
        "Aktuelle statt vorheriger Zeile verwendet.",
        "Indexierung der Gegenstände verschoben.",
        "Optimum genannt, aber Tabellenweg nicht belegt."
      ],
      "examTips": [
        "Erst Rekurrenz und Achsen klären, dann rechnen.",
        "Bei Zeitdruck die letzte Zeile und alle Konfliktzellen besonders sauber halten."
      ],
