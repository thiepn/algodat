{
  "name": "algodat-study-system",
  "version": "1.0.0-rc.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:content && tsc -b && vite build && tsx scripts/create-pages-fallback.ts",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "validate:phase-data": "tsx scripts/validate-phase-data.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:content": "tsx scripts/build-content.ts",
    "check:deployment": "tsx scripts/check-deployment-assets.ts",
    "analyze:bundle": "tsx scripts/analyze-bundle.ts",
    "verify": "npm run validate:phase-data && npm run build:content && npm run validate:content && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:coverage && npm run build && npm run analyze:bundle && npm run check:deployment && playwright test"
  },
  "dependencies": {
    "idb": "8.0.3",
    "katex": "0.17.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router-dom": "7.18.1",
    "workbox-window": "7.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/katex": "0.16.8",
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "jsdom": "29.1.1",
    "prettier": "3.9.4",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vite": "8.1.3",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "vitest-axe": "0.1.0"
  }
}
